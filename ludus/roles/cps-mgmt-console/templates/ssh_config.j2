# SSH config for CPS Console management connections
# Auto-generated by Ansible — do not edit manually

{% for name, target in ssh_targets.items() %}
Host {{ name }}
    HostName {{ target.host }}
    User {{ target.user }}
    Port {{ target.port }}
    StrictHostKeyChecking no
    UserKnownHostsFile /dev/null
    IdentityFile ~/.ssh/id_ed25519
    ConnectTimeout 5

{% endfor %}
