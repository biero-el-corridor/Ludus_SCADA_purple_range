[Unit]
Description=Suricata IDS — probe {{ item.name }} on {{ item.iface }}
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/suricata -c /etc/suricata/suricata-{{ item.name }}.yaml --pidfile /run/suricata-{{ item.name }}.pid -i {{ item.iface }}
ExecReload=/bin/kill -USR2 $MAINPID
Restart=on-failure
RestartSec=5
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
